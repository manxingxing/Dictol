{
  "name": "@dictol/mdict-native",
  "version": "0.1.0",
  "private": true,
  "main": "wrapper.js",
  "types": "wrapper.d.ts",
  "files": [
    "wrapper.js",
    "wrapper.d.ts",
    "index.js",
    "index.d.ts",
    "prebuilds/**/*.node"
  ],
  "scripts": {
    "build": "node build.mjs",
    "build:debug": "node build.mjs --debug",
    "test": "node --test test/*.test.mjs"
  },
  "napi": {
    "binaryName": "dictol-mdict-node",
    "targets": [
      "x86_64-apple-darwin",
      "aarch64-apple-darwin",
      "x86_64-pc-windows-msvc",
      "x86_64-unknown-linux-gnu",
      "aarch64-unknown-linux-gnu"
    ]
  }
}
