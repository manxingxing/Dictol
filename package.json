{
  "name": "dictol",
  "version": "0.3.9",
  "description": "A desktop dictionary reader for MDX and MDD dictionaries",
  "main": "./out/main/index.js",
  "author": "Alan Mann",
  "private": true,
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "start": "electron-vite preview",
    "dev": "npm run system-translation:build && npm run system-translation:stage && electron-vite dev",
    "build": "npm run native:build && npm run system-translation:build && npm run system-translation:stage && npm run adblock:build && npm run typecheck && electron-vite build",
    "build:native": "node scripts/build-native-dependencies.mjs",
    "build:native:mac:x64": "node scripts/build-native-dependencies.mjs --platform mac --arch x64",
    "build:native:mac:arm64": "node scripts/build-native-dependencies.mjs --platform mac --arch arm64",
    "build:native:win:x64": "node scripts/build-native-dependencies.mjs --platform win --arch x64",
    "build:electron": "node scripts/build-electron.mjs",
    "native:build": "node scripts/build-native.mjs",
    "system-translation:build": "node scripts/build-system-translation.mjs",
    "system-translation:stage": "node scripts/stage-system-translation.mjs",
    "native:build:win-x64": "node scripts/build-native.mjs --target x86_64-pc-windows-msvc",
    "native:sign:win-x64": "node scripts/sign-windows-native.mjs",
    "windows:sign-artifacts": "node scripts/sign-windows-artifacts.mjs",
    "win:signing:check": "node scripts/check-windows-signing.mjs",
    "native:test": "npm --prefix native/mdict-node test",
    "db:generate": "drizzle-kit generate",
    "dictionary-note-fts:rebuild": "node scripts/rebuild-dictionary-note-fts.mjs",
    "ecdict:build": "node scripts/build-ecdict.mjs",
    "adblock:prepare": "node scripts/prepare-adblock-network-lists.mjs",
    "adblock:build": "node scripts/build-adblock.mjs",
    "adblock:build:win-x64": "node scripts/build-adblock.mjs --target x86_64-pc-windows-msvc",
    "mdict:inspect": "node scripts/inspect-mdict.mjs",
    "mdict:benchmark": "node scripts/compare-mdict-parsers.mjs",
    "postinstall": "electron-builder install-app-deps",
    "build:unpack": "npm run build && node scripts/package-unpacked.mjs",
    "build:win": "node scripts/build-win.mjs",
    "build:mac": "node scripts/build-mac.mjs x64",
    "build:mac-arm64": "node scripts/build-mac.mjs arm64",
    "build:linux": "node scripts/build-linux.mjs"
  },
  "dependencies": {
    "@dictol/mdict-native": "file:native/mdict-node",
    "@dictol/accessibility-native": "file:native/accessibility",
    "@dictol/screen-capture-native": "file:native/screen-capture",
    "@dictol/ocr-native": "file:native/ocr",
    "@electron-toolkit/utils": "^4.0.0",
    "@radix-ui/react-popover": "^1.1.23",
    "@tiptap/core": "^3.31.4",
    "@tiptap/extension-placeholder": "^3.31.4",
    "@tiptap/markdown": "^3.31.4",
    "@tiptap/pm": "^3.31.4",
    "@tiptap/react": "^3.31.4",
    "@tiptap/starter-kit": "^3.31.4",
    "@tiptap/static-renderer": "^3.31.4",
    "adblock-rs": "^0.13.2",
    "better-sqlite3": "^13.0.1",
    "cmdk": "^1.1.1",
    "drizzle-orm": "^0.45.2",
    "exceljs": "4.4.0",
    "parse5": "^7.3.0",
    "postcss": "^8.5.25",
    "postcss-selector-parser": "^7.1.6",
    "postcss-value-parser": "^4.2.0",
    "selection-hook": "^2.1.1",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@assistant-ui/react": "^0.15.11",
    "@base-ui/react": "^1.8.0",
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.6",
    "@electron-toolkit/eslint-config-prettier": "^3.0.0",
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@lezer/highlight": "^1.2.3",
    "@napi-rs/cli": "^3.0.0",
    "@radix-ui/react-dialog": "^1.1.21",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-scroll-area": "^1.2.16",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.19",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.14.13",
    "@types/better-sqlite3": "^7.6.13",
    "@types/bun": "latest",
    "@types/node": "^24.19.2",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-kit": "^0.31.10",
    "electron": "^44.9.3",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "js-mdict": "^7.0.0",
    "katex": "^0.18.4",
    "lucide-react": "^1.45.0",
    "next-themes": "^0.4.6",
    "prettier": "^3.7.4",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.12.2",
    "react-router-dom": "^7.18.1",
    "react-use": "^17.6.1",
    "rehype-katex": "^7.0.1",
    "rehype-parse": "^9.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-react": "^8.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "sonner": "^2.0.7",
    "style-to-object": "^1.0.14",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3",
    "unified": "^11.0.5",
    "vite": "^7.2.6",
    "zustand": "^5.0.14"
  },
  "allowScripts": {
    "electron@43.2.0": true,
    "fsevents@2.3.3": true,
    "electron-winstaller@5.4.0": true,
    "better-sqlite3@13.0.2": true,
    "selection-hook@2.1.1": true,
    "adblock-rs@0.13.2": true,
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true
  }
}
